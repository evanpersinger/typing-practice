ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# LLM_PROVIDER=local|anthropic|openai, defaults to local. "local" runs against
# Ollama and needs neither key, just `ollama serve` running. Set anthropic or
# openai, plus the matching key above, to use a paid model instead.
# LLM_PROVIDER=anthropic
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen3.5:4b
